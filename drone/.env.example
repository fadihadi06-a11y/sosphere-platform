# ── Drone Agent (server-side only — never in the frontend) ──
# Run one agent process per drone. Uses the Supabase SERVICE key, so it
# must run on a trusted machine (the drone's companion computer / 4G unit),
# never in a browser.
SUPABASE_URL=https://rtfhkbskgrasamhjraul.supabase.co
SUPABASE_SERVICE_KEY=        # service_role key — keep secret
DRONE_ID=                    # uuid from public.drones (created in the dashboard)
DRONE_SOURCE=simulator       # 'simulator' (demo) | 'mavlink' (real drone, later)
