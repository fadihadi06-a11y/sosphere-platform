.tmp_*
*.tmp.cjs
# 2026-06-06 final-audit: also exclude *.tmp siblings — Python in-place
# rebuilds (used to dodge Windows-mount Edit truncation) leave behind
# .tmp snapshots that age into confusing stale references in audits/greps.
*.tmp


.vercel
.env*.local

# Test artifacts (E2E live tests)
test-*.csv
test-e1-*

.vercel

# Database backups — kept locally only, never committed.
# Pre-migration snapshots, ad-hoc pg_dump output, etc. May contain
# secrets / PII / large blobs. Keep them in a top-level `backups/`
# folder for organisation, or use the date-prefixed pattern below.
backups/
backup-*.sql
*.dump
*.sql.gz

scripts/lint-guard/dist/

# ─────────────────────────────────────────────────────────
# P0-Z2: Explicit env-file blocklist (defense-in-depth on top
# of the `.env` and `.env.local` lines above). Catches edge
# cases like `prod.env`, `.env.production`, `.env.staging`,
# `service.env`, etc. that could otherwise slip through.
# Pair with the L1 lefthook gate that blocks commits touching
# any of these patterns; L2 gitleaks deep-scans on push.
# ─────────────────────────────────────────────────────────
*.env
.env.*
!.env.example

# CRIT-3 (2026-06-01): stray CodeQL SARIF artifacts from local scans
work/
*.sarif

# 2026-06-02: one-off PowerShell bridge scripts used to bypass the
# Windows mount index.lock issue. Never meant for the repo.
commit-*.ps1
push-result.txt
commit-result.txt
commit-msg.txt
