# ═══════════════════════════════════════════════════════
# SOSphere Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Supabase (Required) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google OAuth (Required) ──────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Native Capacitor build substitution (read by build script):
GOOGLE_SERVER_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Firebase Cloud Messaging (Optional — for push notifications) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Sentry (Optional in dev, required in prod) ───────────
# DSN from sentry.io project settings. Leave EMPTY in dev so Sentry
# stays dormant (no network traffic, no dashboard noise). Only set
# in Vercel → Production env vars. Without this, prod errors are
# invisible — sentry-client.ts logs a console.error when missing.
VITE_SENTRY_DSN=

# Free-form environment label attached to every Sentry event so you
# can filter by stage. Common values: production / staging / preview.
VITE_ENVIRONMENT=production

# Release tag for Sentry source-map mapping. Set in CI to the git
# commit SHA, e.g. VITE_APP_VERSION=\$(git rev-parse --short HEAD)
# Leave empty locally — Sentry will fall back to "no-release".
VITE_APP_VERSION=

# Toggle the Twilio video bridge on/off without removing code.
# Keep "false" until the legal entity + Twilio account are ready.
# When "true", components that use Twilio mount; otherwise they no-op.
VITE_TWILIO_ENABLED=false

# ═══════════════════════════════════════════════════════
# Supabase Edge Function Secrets (set via supabase CLI)
# supabase secrets set KEY=VALUE
# ═══════════════════════════════════════════════════════

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
# TWILIO_FROM_NUMBER=
# SOSPHERE_BASE_URL=https://sosphere-platform.vercel.app
# RESEND_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Probe authentication (R-4, R-5, R-6 + L1-D 2-3) ──────
# Shared hex secret used by FIVE continuous-monitoring probes:
#   - twilio-config-probe   (Twilio webhook drift detection, L1-D Phase 2)
#   - sos-inbound-probe     (synthetic inbound SMS end-to-end, L1-D Phase 3)
#   - forgery-probe         (R-5: L5-SEC-1 audit-forgery defense)
#   - sos-dispatch-probe    (R-4: end-to-end outbound SOS orchestration)
#   - function-drift-probe  (R-6: deployed-vs-git function drift — script-side)
# Generate a header-safe value (hex only — RFC 6750 bearer-token charset):
#   PowerShell:
#     $bytes = New-Object byte[] 32
#     [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#     ($bytes | ForEach-Object { $_.ToString("x2") }) -join ""
# Then set in BOTH places (must match):
#   - Supabase: supabase secrets set PROBE_SECRET=<value>
#   - GitHub Actions repo secret: PROBE_SECRET=<value>
# If you rotate, update BOTH or the cron monitoring breaks.
# PROBE_SECRET=

# ── R-6 function-drift probe: Supabase Management API access ─────
# Used by scripts/check-function-drift.mjs (called from GHA on every push
# + every 6h). Compares Supabase's ezbr_sha256 fingerprint of each
# deployed edge function against pinned values in
# supabase/functions/.deploy-manifest.json. Detects: forgotten deploys,
# Studio UI hot-fixes, deploys-from-wrong-machine.
#   - SUPABASE_ACCESS_TOKEN: Personal Access Token (sbp_... value)
#     Create at https://supabase.com/dashboard/account/tokens
#     Set as GitHub Actions repo secret. The token IS the auth — no
#     other identity check; treat it like a service-account key.
#   - SUPABASE_PROJECT_REF: the project ref (e.g. abcdefghijklmnop — your project ref)
# After every legitimate `supabase functions deploy <slug>`, also run:
#   npm run drift:update
#   git add supabase/functions/.deploy-manifest.json && git commit && push
# Otherwise R-6 detects drift on the next probe run (within 6 hours).
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# ── Internal probe-user emails (R-10 — informational, no value to set) ──
# These two auth.users rows are created/refreshed automatically by the
# probes on each run. The probe-classification logic in sos-alert (R-13)
# detects them by their @sosphere.internal email domain — a reserved
# internal domain. DO NOT register any real user at @sosphere.internal;
# their pipeline_metrics rows would be silently classified as synthetic.
#   - forgery-probe@sosphere.internal       (R-5)
#   - sos-dispatch-probe@sosphere.internal  (R-10)

# =======================================================
# GitHub Actions repo secrets (Settings -> Secrets and variables -> Actions)
# =======================================================

# Used by .github/workflows/probes.yml (5 probes across 3 cadences):
# SUPA_FN_URL            = https://<project>.functions.supabase.co
#                          (functions subdomain — NOT /functions/v1/ path)
# PROBE_SECRET           = same hex value as the Supabase secret above
# SUPABASE_ACCESS_TOKEN  = Personal Access Token (R-6 only — function-drift)
# SUPABASE_PROJECT_REF   = project ref (R-6 only)
#
# Used by .github/workflows/ci.yml (build/test/lint) + build-apk.yml:
# VITE_SUPABASE_URL      = production Supabase URL
# VITE_SUPABASE_ANON_KEY = production anon key
