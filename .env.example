# ═══════════════════════════════════════════════════════
# SOSphere Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Supabase (Required) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google OAuth (Required) ──────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Native Capacitor build substitution (read by build script):
GOOGLE_SERVER_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Firebase Cloud Messaging (Optional — for push notifications) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Sentry (Optional in dev, required in prod) ───────────
# DSN from sentry.io project settings. Leave EMPTY in dev so Sentry
# stays dormant (no network traffic, no dashboard noise). Only set
# in Vercel → Production env vars. Without this, prod errors are
# invisible — sentry-client.ts logs a console.error when missing.
VITE_SENTRY_DSN=

# Free-form environment label attached to every Sentry event so you
# can filter by stage. Common values: production / staging / preview.
VITE_ENVIRONMENT=production

# Release tag for Sentry source-map mapping. Set in CI to the git
# commit SHA, e.g. VITE_APP_VERSION=\$(git rev-parse --short HEAD)
# Leave empty locally — Sentry will fall back to "no-release".
VITE_APP_VERSION=

# Toggle the Twilio video bridge on/off without removing code.
# Keep "false" until the legal entity + Twilio account are ready.
# When "true", components that use Twilio mount; otherwise they no-op.
VITE_TWILIO_ENABLED=false

# ═══════════════════════════════════════════════════════
# Supabase Edge Function Secrets (set via supabase CLI)
# supabase secrets set KEY=VALUE
# ═══════════════════════════════════════════════════════

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
# TWILIO_FROM_NUMBER=
# SOSPHERE_BASE_URL=https://sosphere-platform.vercel.app
# RESEND_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── L1-D probe authentication (added 2026-05-11) ─────────
# Shared hex secret used by:
#   - twilio-config-probe   (Twilio webhook drift detection)
#   - sos-inbound-probe     (synthetic inbound SMS end-to-end check)
# Generate a header-safe value (hex only — RFC 6750 bearer-token
# charset is restrictive):
#   PowerShell:
#     $bytes = New-Object byte[] 32
#     [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#     ($bytes | ForEach-Object { $_.ToString("x2") }) -join ""
# Then set it in BOTH places (must match):
#   - Supabase: supabase secrets set PROBE_SECRET=<value>
#   - GitHub Actions repo secret: PROBE_SECRET=<value>
# If you rotate, update BOTH or the cron monitoring breaks.
# PROBE_SECRET=

# =======================================================
# GitHub Actions repo secrets (Settings -> Secrets and variables -> Actions)
# =======================================================

# Used by .github/workflows/probes.yml (cron monitoring, every 15 min).
# SUPA_FN_URL = https://<project>.functions.supabase.co
#   (note: functions subdomain, no /functions/v1/ in the path)
# PROBE_SECRET = same hex value as the Supabase secret above
